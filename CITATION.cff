# version and date-released are written by `just cite-sync` at release time and
# checked against Cargo.toml in CI (`just cite-check`); never edit them by hand.
# Keep identities and description synchronized with .zenodo.json.
cff-version: 1.2.0
message: "If you use uno, please cite this software using these metadata."
title: "uno: MS1-only peptide and protein identification"
abstract: "uno is a Rust MS1-only search engine in the spirit of DirectMS1 and ms1searchpy. It searches LC-MS peptide features (from biosaur2, koth, or built-in koth feature finding on mzML, Bruker timsTOF and Thermo RAW files), scores candidates with retention-time and ion-mobility prediction, and estimates FDR with target-decoy competition."
type: software
version: "0.1.0"
date-released: "2026-10-11"
