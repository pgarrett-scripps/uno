+def robust_calib_select(dlc, ns, nr, ns2, nr2, aa_to_psi, mode=1):
+    """Local addition (not in stock ms1searchpy).
+
+    The RT calibration set is built from every peptide of the stage-1
+    proteins, so on data with a high random-match rate most of it is noise
+    and DeepLC's per-bin median calibration, plus the Gaussian sigma fit on
+    the mixture, both inflate. Fit a robust linear map from *uncalibrated*
+    DeepLC predictions to observed RT with RANSAC and keep only the inliers
+    for DeepLC calibration and for the sigma estimate. Falls back to the
+    unfiltered sets if too few inliers remain.
+    """
+    from sklearn.linear_model import RANSACRegressor, LinearRegression
+    ns = np.asarray(ns); nr = np.asarray(nr); ns2 = np.asarray(ns2); nr2 = np.asarray(nr2)
+    seqs = np.concatenate([ns, ns2])
+    rts = np.concatenate([nr, nr2]).astype(float)
+    n1 = len(ns)
+    df = pd.DataFrame({'seq': seqs, 'modifications': [utils.mods_for_deepLC(s, aa_to_psi) for s in seqs]})
+    pred = np.asarray(dlc.make_preds(seq_df=df, calibrate=False), dtype=float)
+    thr = max(0.1, 0.05 * (rts.max() - rts.min()))
+    r = RANSACRegressor(LinearRegression(), residual_threshold=thr, max_trials=1000, random_state=SEED)
+    r.fit(pred.reshape(-1, 1), rts)
+    inl = r.inlier_mask_
+    logger.info('Robust RT calibration: kept %d of %d calibration peptides (linear RANSAC on uncalibrated DeepLC, threshold %.2f min)', int(inl.sum()), len(inl), thr)
+    if inl.sum() < 50 or inl[:n1].sum() < 20 or inl[n1:].sum() < 20:
+        logger.info('Robust RT calibration: too few inliers, using unfiltered calibration set')
+        return ns, nr, ns2, nr2
+    if mode == 2:
+        # clean only the calibration half; sigma is then estimated on the
+        # unfiltered check half (Gaussian + flat background fit)
+        return ns, nr, ns2[inl[n1:]], nr2[inl[n1:]]
+    return ns[inl[:n1]], nr[inl[:n1]], ns2[inl[n1:]], nr2[inl[n1:]]
+
